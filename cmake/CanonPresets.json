{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 6
  },
  "configurePresets": [
    {
      "name": "canon-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CANON_ENABLE_WARNINGS": true
      }
    },
    {
      "name": "canon-gcc",
      "hidden": true,
      "inherits": "canon-base",
      "environment": {
        "CC": "gcc",
        "CXX": "g++"
      }
    },
    {
      "name": "canon-clang",
      "hidden": true,
      "inherits": "canon-base",
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      }
    },
    {
      "name": "canon-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "canon-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "canon-asan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CANON_ENABLE_ASAN": true
      }
    },
    {
      "name": "canon-tidy",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CANON_ENABLE_TIDY": true
      }
    },
    {
      "name": "canon-coverage",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CANON_ENABLE_COVERAGE": true
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "inherits": [
        "canon-gcc",
        "canon-debug"
      ]
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "inherits": [
        "canon-gcc",
        "canon-release"
      ]
    },
    {
      "name": "gcc-asan",
      "displayName": "GCC AddressSanitizer",
      "inherits": [
        "canon-gcc",
        "canon-asan"
      ]
    },
    {
      "name": "gcc-tidy",
      "displayName": "GCC clang-tidy",
      "inherits": [
        "canon-gcc",
        "canon-tidy"
      ]
    },
    {
      "name": "gcc-coverage",
      "displayName": "GCC Coverage",
      "inherits": [
        "canon-gcc",
        "canon-coverage"
      ]
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "inherits": [
        "canon-clang",
        "canon-debug"
      ]
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "inherits": [
        "canon-clang",
        "canon-release"
      ]
    },
    {
      "name": "clang-asan",
      "displayName": "Clang AddressSanitizer",
      "inherits": [
        "canon-clang",
        "canon-asan"
      ]
    },
    {
      "name": "clang-tidy",
      "displayName": "Clang clang-tidy",
      "inherits": [
        "canon-clang",
        "canon-tidy"
      ]
    },
    {
      "name": "clang-coverage",
      "displayName": "Clang Coverage",
      "inherits": [
        "canon-clang",
        "canon-coverage"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release"
    },
    {
      "name": "gcc-asan",
      "configurePreset": "gcc-asan"
    },
    {
      "name": "gcc-tidy",
      "configurePreset": "gcc-tidy"
    },
    {
      "name": "gcc-coverage-clean",
      "configurePreset": "gcc-coverage",
      "targets": [
        "coverage-clean"
      ]
    },
    {
      "name": "gcc-coverage",
      "configurePreset": "gcc-coverage"
    },
    {
      "name": "gcc-coverage-report",
      "configurePreset": "gcc-coverage",
      "targets": [
        "coverage-report"
      ]
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release"
    },
    {
      "name": "clang-asan",
      "configurePreset": "clang-asan"
    },
    {
      "name": "clang-tidy",
      "configurePreset": "clang-tidy"
    },
    {
      "name": "clang-coverage-clean",
      "configurePreset": "clang-coverage",
      "targets": [
        "coverage-clean"
      ]
    },
    {
      "name": "clang-coverage",
      "configurePreset": "clang-coverage"
    },
    {
      "name": "clang-coverage-report",
      "configurePreset": "clang-coverage",
      "targets": [
        "coverage-report"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "_canon-test",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "gcc-debug",
      "inherits": "_canon-test",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "gcc-release",
      "inherits": "_canon-test",
      "configurePreset": "gcc-release"
    },
    {
      "name": "gcc-asan",
      "inherits": "_canon-test",
      "configurePreset": "gcc-asan"
    },
    {
      "name": "gcc-tidy",
      "inherits": "_canon-test",
      "configurePreset": "gcc-tidy"
    },
    {
      "name": "gcc-coverage",
      "inherits": "_canon-test",
      "configurePreset": "gcc-coverage"
    },
    {
      "name": "clang-debug",
      "inherits": "_canon-test",
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-release",
      "inherits": "_canon-test",
      "configurePreset": "clang-release"
    },
    {
      "name": "clang-asan",
      "inherits": "_canon-test",
      "configurePreset": "clang-asan"
    },
    {
      "name": "clang-tidy",
      "inherits": "_canon-test",
      "configurePreset": "clang-tidy"
    },
    {
      "name": "clang-coverage",
      "inherits": "_canon-test",
      "configurePreset": "clang-coverage"
    }
  ],
  "workflowPresets": [
    {
      "name": "gcc-debug",
      "steps": [
        {
          "type": "configure",
          "name": "gcc-debug"
        },
        {
          "type": "build",
          "name": "gcc-debug"
        },
        {
          "type": "test",
          "name": "gcc-debug"
        }
      ]
    },
    {
      "name": "gcc-release",
      "steps": [
        {
          "type": "configure",
          "name": "gcc-release"
        },
        {
          "type": "build",
          "name": "gcc-release"
        },
        {
          "type": "test",
          "name": "gcc-release"
        }
      ]
    },
    {
      "name": "gcc-asan",
      "steps": [
        {
          "type": "configure",
          "name": "gcc-asan"
        },
        {
          "type": "build",
          "name": "gcc-asan"
        },
        {
          "type": "test",
          "name": "gcc-asan"
        }
      ]
    },
    {
      "name": "gcc-tidy",
      "steps": [
        {
          "type": "configure",
          "name": "gcc-tidy"
        },
        {
          "type": "build",
          "name": "gcc-tidy"
        },
        {
          "type": "test",
          "name": "gcc-tidy"
        }
      ]
    },
    {
      "name": "gcc-coverage",
      "steps": [
        {
          "type": "configure",
          "name": "gcc-coverage"
        },
        {
          "type": "build",
          "name": "gcc-coverage-clean"
        },
        {
          "type": "build",
          "name": "gcc-coverage"
        },
        {
          "type": "test",
          "name": "gcc-coverage"
        },
        {
          "type": "build",
          "name": "gcc-coverage-report"
        }
      ]
    },
    {
      "name": "clang-debug",
      "steps": [
        {
          "type": "configure",
          "name": "clang-debug"
        },
        {
          "type": "build",
          "name": "clang-debug"
        },
        {
          "type": "test",
          "name": "clang-debug"
        }
      ]
    },
    {
      "name": "clang-release",
      "steps": [
        {
          "type": "configure",
          "name": "clang-release"
        },
        {
          "type": "build",
          "name": "clang-release"
        },
        {
          "type": "test",
          "name": "clang-release"
        }
      ]
    },
    {
      "name": "clang-asan",
      "steps": [
        {
          "type": "configure",
          "name": "clang-asan"
        },
        {
          "type": "build",
          "name": "clang-asan"
        },
        {
          "type": "test",
          "name": "clang-asan"
        }
      ]
    },
    {
      "name": "clang-tidy",
      "steps": [
        {
          "type": "configure",
          "name": "clang-tidy"
        },
        {
          "type": "build",
          "name": "clang-tidy"
        },
        {
          "type": "test",
          "name": "clang-tidy"
        }
      ]
    },
    {
      "name": "clang-coverage",
      "steps": [
        {
          "type": "configure",
          "name": "clang-coverage"
        },
        {
          "type": "build",
          "name": "clang-coverage-clean"
        },
        {
          "type": "build",
          "name": "clang-coverage"
        },
        {
          "type": "test",
          "name": "clang-coverage"
        },
        {
          "type": "build",
          "name": "clang-coverage-report"
        }
      ]
    }
  ]
}
